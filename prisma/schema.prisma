generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  telephone String?
  role      String   @default("client")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entreprises Entreprise[]

  contentItemsAssignes ContentItem[]        @relation("ContentAssigne")
  contentItemsCrees    ContentItem[]        @relation("ContentCreateur")
  contentActivityLogs  ContentActivityLog[] @relation("ContentActivityUser")
}

enum CategorieEntreprise {
  entreprise_privee
  administration_publique
  banque
  assurance
  hotel
  compagnie_aerienne
  ong
  ambassade
  ecole
  universite
  clinique
  cabinet_medical
  cabinet_avocat
  notaire
  agence_immobiliere
  entreprise_miniere
  societe_petroliere
  btp
  securite_privee
  evenementiel
  mosquee
  association
  comite_entreprise
  particulier_vip
}

enum StatutPipeline {
  prospect_identifie
  premier_contact
  visite_effectuee
  besoin_identifie
  devis_envoye
  relance_1
  relance_2
  negociation
  contrat_signe
  client_actif
  client_fidele
  perdu
}

enum TypeBesoin {
  navette_entreprise
  navette_aeroport
  billetterie
  voyages_affaires
  tourisme
  sejours
  visa
  omra
  hajj
  transport_evenementiel
  location_vehicule
  autres
}

model Entreprise {
  id                String              @id @default(cuid())
  nom               String
  nomCommercial     String?
  rccm              String?
  categorie         CategorieEntreprise
  secteurActivite   String?
  effectif          Int?
  dateCreation      DateTime?
  siteInternet      String?
  facebook          String?
  linkedin          String?
  instagram         String?

  pays              String   @default("Côte d'Ivoire")
  ville             String
  commune           String
  quartier          String?
  rue               String?
  immeuble          String?
  latitude          Float?
  longitude         Float?
  secteurCommercial String?
  zoneCommerciale   String?

  telephoneFixe     String?
  whatsapp          String?
  emailPrincipal    String?
  emailSecondaire   String?
  horaires          String?
  observations      String?  @db.Text

  statutPipeline    StatutPipeline @default(prospect_identifie)
  probabiliteVente  Int?
  montantEstime     Decimal?       @db.Decimal(12, 0)

  commercialId      String?
  commercial        User?    @relation(fields: [commercialId], references: [id])

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contacts          Contact[]
  besoins           BesoinIdentifie[]
}

model Contact {
  id               String     @id @default(cuid())
  entrepriseId     String
  entreprise       Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)

  nom              String
  prenom           String
  fonction         String?
  telephone        String?
  whatsapp         String?
  email            String?
  dateAnniversaire DateTime?
  centreInteret    String?
  estDecideur      Boolean  @default(false)
  estInfluenceur   Boolean  @default(false)
  estUtilisateur   Boolean  @default(false)

  createdAt        DateTime @default(now())
}

model BesoinIdentifie {
  id           String     @id @default(cuid())
  entrepriseId String
  entreprise   Entreprise @relation(fields: [entrepriseId], references: [id], onDelete: Cascade)
  type         TypeBesoin
  details      String?    @db.Text
  createdAt    DateTime   @default(now())
}

model ServiceCategory {
  id    String        @id @default(cuid())
  slug  String        @unique
  label String
  icon  String
  items ServiceItem[]
}

model ServiceItem {
  id                   String   @id @default(cuid())
  categoryId           String
  category             ServiceCategory @relation(fields: [categoryId], references: [id])
  slug                 String
  title                String
  subtitle             String?
  description          String?
  image                String?
  icon                 String?
  badge                String?
  price                String
  priceGridQuad        String?
  priceGridTriple      String?
  priceGridDouble      String?
  priceGridIndividuelle String?
  tags                 String?
  sessions             OmraSession[]

  @@unique([categoryId, slug])
}

model OmraSession {
  id           String      @id @default(cuid())
  itemId       String
  item         ServiceItem @relation(fields: [itemId], references: [id])
  periode      String
  duree        String
  image        String
  quad         String?
  triple       String
  double       String
  individuelle String
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String?
  coverImage  String?
  videoUrl    String?
  content     String   @db.Text
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ============================================================
// MODULE CONTENT HUB — suivi éditorial de l'équipe communication
// ============================================================

enum ContentRubrique {
  omra_conseils
  billetterie_express
  visa_formalites
  destination_ci
  spiritualite
  transport_navettes
  temoignages_vie_sira
}

enum ContentCouche {
  moteur_commercial
  services_permanents
  marque
}

enum ContentFormat {
  article_seo
  facebook
  instagram
  linkedin
  tiktok
  reel
  youtube_short
  youtube_video
  newsletter
  whatsapp
  story
  pinterest
  google_business
  faq
  carrousel
  voix_off
}

enum ContentStatut {
  a_faire
  en_cours
  a_valider
  publie
}

model ContentItem {
  id                     String          @id @default(cuid())
  titre                  String
  theme                  String?
  rubrique               ContentRubrique
  couche                 ContentCouche   @default(moteur_commercial)
  format                 ContentFormat
  statut                 ContentStatut   @default(a_faire)
  texte                  String?         @db.Text
  lienVisuel             String?
  hashtags               String?
  datePublicationPrevue  DateTime?
  datePublicationReelle  DateTime?

  assigneId              String?
  assigne                User?           @relation("ContentAssigne", fields: [assigneId], references: [id])

  createdById            String?
  createdBy              User?           @relation("ContentCreateur", fields: [createdById], references: [id])

  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt

  activityLogs           ContentActivityLog[]
}

model ContentActivityLog {
  id            String         @id @default(cuid())
  contentItemId String
  contentItem   ContentItem    @relation(fields: [contentItemId], references: [id], onDelete: Cascade)

  userId        String?
  user          User?          @relation("ContentActivityUser", fields: [userId], references: [id])

  action        String
  ancienStatut  ContentStatut?
  nouveauStatut ContentStatut?

  createdAt     DateTime       @default(now())
}